# n8n host settings
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
TIMEZONE=America/New_York

# Auth (set to true + credentials for production)
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=changeme

# Database
POSTGRES_PASSWORD=n8npassword

# Zaidsaid proxy (deployed Cloudflare Worker)
ZAIDSAID_PROXY_URL=https://zaidsaid-proxy.zaidsaid.workers.dev

# API Keys (mirror what's in your Cloudflare Worker secrets)
ANTHROPIC_KEY=sk-ant-...
XAI_KEY=xai-...
ELEVEN_KEY=...
